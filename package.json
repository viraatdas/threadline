{
  "name": "threadline",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-only outbound for Offstage: find teams that need Macs, research them, and run email + LinkedIn sequences you approve.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "scout": "tsx scripts/scout.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "^7.0.34",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
