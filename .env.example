# Owner sign-in (Google OAuth through Auth.js)
AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
OWNER_EMAIL=owner@example.com
AUTH_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/outbound

# Base64-encoded 32-byte key sealing Gmail/LinkedIn/GitHub/Apollo credentials
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
INTEGRATION_ENCRYPTION_KEY_VERSION=1

# Daily cron (Vercel sends it automatically) and the local `pnpm scout` CLI
CRON_SECRET=replace-with-a-random-secret
IMPORT_TOKEN=replace-with-a-random-secret
OUTBOUND_URL=http://localhost:3000

# Must match the Google OAuth client's authorized redirect URI
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Research + drafting. Without it, model ids go through the Vercel AI Gateway.
OPENROUTER_API_KEY=replace-with-openrouter-key
# AI_RESEARCH_MODEL=anthropic/claude-haiku-5.5
# AI_DRAFT_MODEL=anthropic/claude-sonnet-5.5

# Optional; both can also be pasted in Settings
# GITHUB_TOKEN=
# APOLLO_API_KEY=
# BROWSER_USE_MODEL=   # optional Browser Use Cloud model for LinkedIn runs (API default otherwise)
